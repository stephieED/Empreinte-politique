      <point nivpoint="4" structure="Oui" valeur_ptsodj="3" ordinal_prise="7" id_preparation="2903145" ordre_absolu_seance="391" id_acteur="PA795310" id_mandat="PM840453" id_nomination_oe="0" id_nomination_op="PM873243" orateur="" code_grammaire="DISC_ARTICLES_3_1" code_parole="" sommaire="1" id_syceron="4050064" valeur=" 494" bibard=" (n[[o]] 2250)" art=" 9 terdecies" adt=" 494" ssadt="">
        <interExtraction nom_orateur="M. Daniel Labaronne" qualite="rapporteur pour avis" id_acteur="PA719798" id_nomination_oe="-1" id_nomination_op="-9270283" id_mandat="PM842753">
          <paragraphe valeur_ptsodj="3" ordinal_prise="7" id_preparation="2903145" ordre_absolu_seance="391" id_acteur="PA795310" id_mandat="PM840453" id_nomination_oe="0" id_nomination_op="PM873243" code_grammaire="DISC_ARTICLES_3_1" code_style="NORMAL" code_parole="" sommaire="1" id_syceron="4050064" valeur=" 494" bibard=" (n[[o]] 2250)" art=" 9 terdecies" adt=" 494" ssadt="" roledebat="president">
            <orateurs>
              <orateur>
                <nom>Mme la présidente</nom>
                <id>795310</id>
                <qualite />
              </orateur>
            </orateurs>
            <texte stime="6745.54">La parole est à M. le rapporteur pour avis, pour soutenir l’amendement n<exposant>o</exposant> 494, visant à supprimer l’article 9 <italique> terdecies</italique> et sur lequel je suis saisie d’une demande de scrutin public par le groupe Ensemble pour la République.<br /> Le scrutin est annoncé dans l’enceinte de l’Assemblée nationale.</texte>
          </paragraphe>
          <paragraphe valeur_ptsodj="3" ordinal_prise="7" id_preparation="2903146" ordre_absolu_seance="392" id_acteur="PA719798" id_mandat="PM842753" id_nomination_oe="-1" id_nomination_op="-9270283" code_grammaire="DISC_ARTICLES_3_4_1" code_style="NORMAL" code_parole="" sommaire="0" id_syceron="4050065" valeur="" bibard=" (n[[o]] 2250)" art=" 9 terdecies" adt=" 494" ssadt="">
            <orateurs>
              <orateur>
                <nom>M. Daniel Labaronne</nom>
                <id>719798</id>
                <qualite>rapporteur pour avis</qualite>
              </orateur>
            </orateurs>
            <texte stime="6750.96">L’article 9 <italique> terdecies</italique> crée une obligation déclarative pour les acquisitions de biens immobiliers en France par des personnes morales étrangères. Or le nouveau règlement européen antiblanchiment prévoit déjà que les entités et les constructions juridiques étrangères faisant l’acquisition de biens immobiliers en France déclarent leurs bénéficiaires effectifs. Un lourd travail de développement est donc en cours pour créer l’infrastructure de collecte de ces données et les registres qui conserveront la liste des bénéficiaires effectifs. Il convient de ne pas modifier encore le dispositif existant afin de ne pas perturber le déploiement de cette infrastructure. C’est pourquoi je propose de supprimer l’article.</texte>
          </paragraphe>
        </interExtraction>
        <paragraphe valeur_ptsodj="3" ordinal_prise="7" id_preparation="2903148" ordre_absolu_seance="393" id_acteur="PA795310" id_mandat="PM840453" id_nomination_oe="0" id_nomination_op="PM873243" code_grammaire="PAROLE_GENERIQUE" code_style="NORMAL" code_parole="" sommaire="0" id_syceron="4050067" valeur="">
          <orateurs>
            <orateur>
              <nom>Mme la présidente</nom>
              <id>795310</id>
              <qualite />
            </orateur>
          </orateurs>
          <texte stime="6752.35">Quel est l’avis du gouvernement ?</texte>
        </paragraphe>
