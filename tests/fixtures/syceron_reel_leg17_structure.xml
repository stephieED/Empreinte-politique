      <paragraphe valeur_ptsodj="3" ordinal_prise="7" id_preparation="2903138" ordre_absolu_seance="385" id_acteur="PA795318" id_mandat="PM843689" id_nomination_oe="-1" id_nomination_op="-1" code_grammaire="PAROLE_GENERIQUE" code_style="NORMAL" code_parole="" sommaire="1" id_syceron="4050057" valeur="">
