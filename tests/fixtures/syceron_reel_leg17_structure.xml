    <point nivpoint="2" valeur_ptsodj="1" ordinal_prise="1" id_preparation="2902790" ordre_absolu_seance="7" code_grammaire="QG_1_1" code_style="Sous-tit_p_cap" code_parole="" sommaire="1" id_syceron="4049544" valeur="">
