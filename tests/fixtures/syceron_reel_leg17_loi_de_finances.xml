        <orateurs>
          <orateur>
            <nom>Mme la présidente</nom>
            <id>795228</id>
            <qualite />
          </orateur>
        </orateurs>
        <texte stime="909.65">Je suis saisie de plusieurs amendements, n<exposant>os</exposant> 2280, 2269, 2266, 2276, 2272, 1549, 2592 et 1557, pouvant être soumis à une discussion commune.<br /> Les amendements n<exposant>os</exposant> 1549 et 2592 sont identiques.</texte>
      </paragraphe>
